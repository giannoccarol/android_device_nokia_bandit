// Backlight-only lights HAL: the Lumia 1520 has no notification LED and
// no separately controlled button backlight.
cc_library_shared {
    name: "lights.msm8974",
    relative_install_path: "hw",
    vendor: true,
    srcs: ["lights.c"],
    shared_libs: [
        "libcutils",
        "liblog",
    ],
    header_libs: ["libhardware_headers"],
    cflags: ["-Wall", "-Werror"],
}
