// From device/oppo/msm8974-common/libshims: the Qualcomm RIL blob
// (libril-qc-qmi-1.so) still calls AudioSystem::setErrorCallback.
cc_library_shared {
    name: "libaudioclient_shim",
    srcs: ["libaudioclient_shim.cpp"],
    shared_libs: ["libaudioclient"],
    vendor: true,
}
