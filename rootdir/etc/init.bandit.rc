# Nokia Lumia 1520 (bandit)

import /vendor/etc/init/hw/init.bandit.qcom.rc

on fs
    mount_all /vendor/etc/fstab.bandit --early
    start hwservicemanager

on late-fs
    start hwservicemanager
    start servicemanager
    start surfaceflinger
    start configstore-hal-1-0
    start gralloc-2-0
    mount_all /vendor/etc/fstab.bandit --late

on post-fs-data
    # Factory reset protection: PersistentDataBlockService (system_server)
    # opens ro.frp.pst; the block node is root-only by default
    chown system system /dev/block/platform/msm_sdcc.1/by-name/persistent
    chmod 0660 /dev/block/platform/msm_sdcc.1/by-name/persistent

on boot
    # zram swap (fstab.bandit), LZ4 is cheaper than LZO on one Krait core
    write /sys/block/zram0/comp_algorithm lz4
    swapon_all /vendor/etc/fstab.bandit
