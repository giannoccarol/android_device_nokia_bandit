# Nokia Lumia 1520 (bandit)

# Display: no Qualcomm content adaptive backlight
ro.qualcomm.cabl=0

# Radio: Qualcomm QMI RIL from the generic MSM8974 blobs
rild.libpath=/system/vendor/lib/libril-qc-qmi-1.so
vendor.rild.libpath=/system/vendor/lib/libril-qc-qmi-1.so
persist.radio.add_power_save=1
persist.radio.apm_sim_not_pwdn=1
ro.ril.ext.ecclist=112,911,999,110,122,119,120,000,08,118
